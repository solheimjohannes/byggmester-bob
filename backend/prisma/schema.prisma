generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventVisibility {
  public
  private
}

enum EventStatus {
  draft
  published
  cancelled
}

enum AttendeeStatus {
  confirmed
  waitlisted
  cancelled
}

enum FriendshipStatus {
  pending
  accepted
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  bio           String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events                Event[]
  attendees             Attendee[]
  friendshipsRequested  Friendship[] @relation("FriendshipRequester")
  friendshipsReceived   Friendship[] @relation("FriendshipAddressee")
}

model Venue {
  id      String  @id @default(cuid())
  name    String?
  address String?
  city    String?

  events Event[]
}

model Event {
  id           String          @id @default(cuid())
  title        String
  description  String?
  startAt      DateTime        @db.Timestamptz
  endAt        DateTime        @db.Timestamptz
  timezone     String
  venueId      String?
  venue        Venue?          @relation(fields: [venueId], references: [id])
  visibility   EventVisibility @default(public)
  inviteToken  String?         @unique
  maxAttendees Int?
  status       EventStatus     @default(draft)
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  attendees    Attendee[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Attendee {
  id        String         @id @default(cuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  status    AttendeeStatus @default(confirmed)
  createdAt DateTime       @default(now())
}

// Bidirectional friendship: one row per request, status tracks lifecycle.
// requesterId sent the invite; addresseeId received it.
// A unique constraint on (requesterId, addresseeId) prevents duplicate requests;
// the self-reference check is enforced at the DB level via a migration constraint.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
}
