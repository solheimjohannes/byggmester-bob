# Server configuration
PORT=3001
NODE_ENV=development

# PostgreSQL connection string — production server: Azure Database for PostgreSQL – Flexible Server.
# Get the actual value (incl. auto-generated password) from Key Vault:
#   az keyvault secret show --vault-name kv-byggmester-production --name DATABASE-URL --query value -o tsv
# In Azure App Service, set this app setting to the Key Vault reference instead:
#   @Microsoft.KeyVault(VaultName=kv-byggmester-production;SecretName=DATABASE-URL)
DATABASE_URL="postgresql://pgadmin:<password>@psql-byggmester-production.postgres.database.azure.com:5432/byggmester?sslmode=require"

# Session secret — must be a long, random string in production (Azure Key Vault → SESSION-SECRET)
SESSION_SECRET="change-me-to-a-long-random-secret-in-production"

# Allowed CORS origin (frontend URL); defaults to http://localhost:5173 in dev
CORS_ORIGIN=http://localhost:5173
